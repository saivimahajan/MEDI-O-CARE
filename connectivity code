# UPDATE STOCK
# ----------------------------------------------------------------------------------------------------
def update_stock():
    if not verify_admin():
        return
    con = get_connection()
    cur = con.cursor()
    cur.execute("USE mediocare")
    while True:
        raw = input("Enter ID (or 'done'): ").strip()
        if raw.lower() == "done":
            cur.close()
            con.close()
            return
        try:
            pid = int(raw)
        except:
            print("Invalid ID.")
            continue
        cur.execute("SELECT 1 FROM medicines WHERE ID=%s", (pid,))
        in_medicines = cur.fetchone() is not None
        cur.execute("SELECT 1 FROM misc WHERE ID=%s", (pid,))
        in_misc = cur.fetchone() is not None
        if in_medicines and not in_misc:
            table = "medicines"
        elif in_misc and not in_medicines:
            table = "misc"
        elif in_medicines and in_misc:
            print("ID found in both tables. Which table do you want to update?")
            print("1) Medicines 2) Misc")
            t = input("Select table: ").strip()
            table = "medicines" if t == "1" else "misc"
        else:
            print("Invalid ID.")
            continue
        cur.execute(f"SELECT Qoh FROM {table} WHERE ID=%s", (pid,))
        res = cur.fetchone()
        current_qoh = res[0] if res and res[0] is not None else 0
        newq = get_positive_or_null("Enter quantity to ADD to QOH")
        if newq is None:
            print("No change made for this item.")
            continue
        try:
            newq_int = int(newq)
        except:
            print("QOH must be an integer. Stock not updated.")
            continue
        cur.execute(f"UPDATE {table} SET Qoh = Qoh + %s WHERE ID = %s",
                    (newq_int, pid))
        con.commit()
        print(f"Stock updated for ID {pid} in table '{table}'. Previous QOH: {current_qoh}, Added: {newq_int}, New QOH: {current_qoh + newq_int}")
