def get_positive_or_null(prompt):
    while True:
        value = input(prompt + " (or 'n' for NULL): ").strip()
        if value.lower() == "n":
            return None
        try:
            value = int(value)
            if value > 0:
                return value
            print("Value must be positive.")
        except ValueError:
            print("Invalid input.")
def get_valid_date(prompt):
    while True:
        value = input(prompt + " (YYYY-MM-DD or 'n' for NULL): ").strip()
        if value.lower() == "n":
            return None
        try:
            datetime.strptime(value, "%Y-%m-%d")
            return value
        except ValueError:
            print("Invalid date format.")
def read_multiline(prompt):
    print(prompt + " (end with empty line):")
    lines = []
    while True:
        line = input()
        if line == "":
            break
        lines.append(line)
    return "\n".join(lines)
