    while True:
        column = input("Column name: ").strip()
        if column in allowed_columns:
            break
        print("Invalid column name. Enter one of:", ", ".join(allowed_columns))
    value = input("New value: ").strip()
    try:
        cur.execute(f"UPDATE {table} SET {column} = %s WHERE ID = %s", (value, id_))
        con.commit()
    except mysql.connector.Error as e:
        print("Error updating value:", e)
    finally:
        cur.close()
        con.close()
    print("Updated. \n")
