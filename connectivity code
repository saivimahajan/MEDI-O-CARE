# PASSWORD CHECK
# ----------------------------------------------------------------------------------------------------
def verify_admin():
    try:
        with open("cache.dat", "r") as f:
            lines = f.readlines()
    except FileNotFoundError:
        print("Setup not found. Run Setup Wizard first.")
        return False
    stored_hash = None
    for line in lines:
        if line.startswith("password:"):
            stored_hash = line.split(":", 1)[1].strip()
    if stored_hash is None:
        print("Password not found in setup file.")
        return False
    attempts = 0
    while attempts < 5:
        pwd = input("Enter admin password: ").strip()
        h = sha256()
        h.update(pwd.encode())
        if h.hexdigest() == stored_hash:
            return True
        print("Wrong password.")
        attempts += 1
    print("Too many failed attempts.")
    return False
