# ----------------------------------------------------------------------------------------------------
def billing():
    con = get_connection()
    cur = con.cursor()
    cur.execute('use mediocare')
    print("\n--- MEDICINES ---")
    cur.execute("SELECT ID,Name,Price,Qoh FROM medicines")
    t1 = PrettyTable(["ID", "Name", "Price", "QOH"])
    for r in cur.fetchall():
        t1.add_row(r)
    print(t1)
    print("\n--- MISC ---")
    cur.execute("SELECT ID,Name,Price,Qoh FROM misc")
    t2 = PrettyTable(["ID", "Name", "Price", "QOH"])
    for r in cur.fetchall():
        t2.add_row(r)
    print(t2)
    cart = []
    reserved = {}
    while True:
        raw = input("\nEnter ID (or 'done'): ").strip()
        if raw.lower() == "done":
            break
        try:
            pid = int(raw)
        except:
            print("Invalid ID.")
            continue
        qty = input("Qty: ").strip()
        try:
            qty = int(qty)
            if qty <= 0:
                print("Quantity must be positive.")
                continue
        except:
            print("Invalid quantity.")
            continue
        cur.execute("""
            SELECT ID,Name,Price,Qoh,'medicines' FROM medicines WHERE ID=%s
            UNION
            SELECT ID,Name,Price,Qoh,'misc' FROM misc WHERE ID=%s
        """, (pid, pid))
        item = cur.fetchone()
        if not item:
            print("Invalid ID.")
            continue
        item_id = item[0]
        item_name = item[1]
        item_price = item[2]
        item_qoh = item[3] if item[3] is not None else 0
        item_src = item[4]
        key = (item_id, item_src)
        already_reserved = reserved.get(key, 0)
        available = item_qoh - already_reserved
        if available <= 0:
            print(f"Out of stock. No units available for '{item_name}' (ID {item_id}).")
            continue
        if qty > available:
            print(f"Out of stock. Only {available} unit(s) available for '{item_name}'.")
            continue
        reserved[key] = already_reserved + qty
        cart.append((item_id, item_name, item_price, qty, item_src))
    if not cart:
        print("Empty cart.")
        cur.close()
        con.close()
        return
    bt = PrettyTable(["ID", "Name", "Qty", "Rate", "Amount"])
    total = 0
    for id_, name, price, qty, src in cart:
        amt = price * qty
        total += amt
        bt.add_row([id_, name, qty, price, amt])
        if src == "medicines":
            cur.execute("UPDATE medicines SET Qoh=Qoh-%s WHERE ID=%s", (qty, id_))
        else:
            cur.execute("UPDATE misc SET Qoh=Qoh-%s WHERE ID=%s", (qty, id_))
    con.commit()
    print("\n--- BILL ---")
    print(bt)
    print("TOTAL: {}".format(total))
    now = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    home = os.path.expanduser("~")
    path = os.path.join(home, "Documents")
    if not os.path.isdir(path):
        path = home
    file = os.path.join(path, "receipt_{}.txt".format(now))
    with open(file, "w") as f:
        f.write(bt.get_string())
        f.write("\nTOTAL: {}".format(total))
    print("Receipt saved: {}".format(file))
    cur.close()
    con.close()
